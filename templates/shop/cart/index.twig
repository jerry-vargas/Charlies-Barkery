{% extends '_layout.twig' %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-gray-50 py-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {{ sprig('_sprig/cart') }}

    </div>
  </section>

  <script>
  // Step qty and immediately submit via htmx
  function stepCartQty(btn, direction) {
    const input = btn.parentElement.querySelector('input[type="number"]');
    if (!input) return;
    input.value = Math.max(0, parseInt(input.value || 0) + direction);
    const form = btn.closest('form');
    if (form && window.htmx) htmx.trigger(form, 'submit');
  }

  // Auto-submit when qty is changed directly (typed + blur)
  document.addEventListener('change', function(e) {
    if (e.target.type === 'number' && e.target.name && e.target.name.includes('lineItems')) {
      const form = e.target.closest('form');
      if (form && window.htmx) htmx.trigger(form, 'submit');
    }
  });
  </script>

{% endblock %}
