{% extends '_layout.twig' %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-gray-50 py-10 sm:py-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {{ sprig('_sprig/cart') }}

    </div>
  </section>

  <script>
  // Step qty — dispatch a native change event so htmx s-trigger="change" picks it up
  function stepCartQty(btn, direction) {
    const input = btn.parentElement.querySelector('input[type="number"]');
    if (!input) return;
    input.value = Math.max(0, parseInt(input.value || 0) + direction);
    input.dispatchEvent(new Event('change', { bubbles: true }));
  }
  </script>

{% endblock %}
