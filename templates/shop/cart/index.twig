{% extends '_layout.twig' %}
{#
@var cart \craft\commerce\elements\Order
#}

{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-10">
        <p class="font-hobeaux text-xs text-teal uppercase tracking-widest mb-1">Your Order</p>
        <h1 class="font-anton text-charcoal text-4xl">Shopping Cart</h1>
      </div>

      {% if cart.lineItems|length %}
        <form method="post" action="">
          {{ csrfInput() }}
          {{ actionInput('commerce/cart/update-cart') }}
          {{ successMessageInput('Cart updated.') }}

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            {# Left: Line Items #}
            <div class="lg:col-span-2 flex flex-col gap-4">

              {% for item in cart.lineItems %}
                <div class="bg-gray-50 rounded-3xl p-6 flex flex-col gap-5 {{ item.hasErrors() ? 'ring-2 ring-red-400' }}">

                  {# Product name + price #}
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                      <p class="font-hobeaux font-bold text-charcoal text-lg leading-snug {{ item.hasErrors() ? 'text-red-500' }}">{{ item.description }}</p>
                      <p class="font-hobeaux text-sm text-charcoal/60 mt-1">SKU: {{ item.sku }}</p>
                    </div>
                    <div class="text-right shrink-0">
                      {% if item.onPromotion %}
                        <p class="font-hobeaux text-sm text-charcoal/50 line-through">{{ item.priceAsCurrency }}</p>
                        <p class="font-anton text-charcoal text-2xl">{{ item.salePriceAsCurrency }}</p>
                      {% else %}
                        <p class="font-anton text-charcoal text-2xl">{{ item.priceAsCurrency }}</p>
                      {% endif %}
                      {% if item.qty > 1 %}
                        <p class="font-hobeaux text-sm text-charcoal/60 mt-0.5">{{ item.subtotalAsCurrency }} total</p>
                      {% endif %}
                    </div>
                  </div>

                  {# Qty stepper + note #}
                  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    {# Qty stepper #}
                    <div class="flex items-center border border-gray-300 rounded-full w-fit">
                      <button type="button" onclick="stepCartQty(this, -1)" aria-label="Decrease quantity"
                        class="w-11 h-11 flex items-center justify-center font-bold text-charcoal hover:text-teal transition-colors text-xl rounded-full leading-none">
                        &minus;
                      </button>
                      {{ input('number', 'lineItems[' ~ item.id ~ '][qty]', item.qty, {
                        min: 0,
                        class: 'w-12 text-center font-hobeaux text-base text-charcoal focus:outline-none bg-transparent'
                      }) }}
                      <button type="button" onclick="stepCartQty(this, 1)" aria-label="Increase quantity"
                        class="w-11 h-11 flex items-center justify-center font-bold text-charcoal hover:text-teal transition-colors text-xl rounded-full leading-none">
                        +
                      </button>
                    </div>

                    {# Item note #}
                    <div class="flex-1">
                      {{ input('text', 'lineItems[' ~ item.id ~ '][note]', item.note, {
                        id: 'lineitem-note-' ~ item.id,
                        class: 'w-full font-hobeaux text-sm text-charcoal border border-gray-300 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors bg-white placeholder-charcoal/40',
                        placeholder: 'Add a special note...'
                      }) }}
                    </div>
                  </div>

                  {% if item.getFirstError('qty') %}
                    <p class="font-hobeaux text-sm text-red-500">{{ item.getFirstError('qty') }}</p>
                  {% endif %}

                  {# Item adjustments + remove #}
                  <div class="flex items-end justify-between gap-4">
                    <div class="flex-1">
                      {% if not cart.hasErrors() and item.adjustments|length %}
                        <div class="flex flex-col gap-1">
                          {% for adjustment in item.adjustments %}
                            <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
                              <span>{{ adjustment.name }}{% if adjustment.isEstimated %} <em class="text-xs">(estimated)</em>{% endif %}</span>
                              <span>{{ adjustment.amountAsCurrency }}</span>
                            </div>
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>
                    {# Remove — visible button, clear tap target #}
                    <label class="flex items-center gap-2 cursor-pointer group">
                      {{ input('checkbox', 'lineItems[' ~ item.id ~ '][remove]', 1, { class: 'sr-only' }) }}
                      <span class="font-hobeaux text-sm font-bold text-charcoal/50 group-hover:text-red-500 border border-charcoal/20 group-hover:border-red-300 px-4 py-2 rounded-full transition-colors">
                        Remove
                      </span>
                    </label>
                  </div>

                </div>
              {% endfor %}

              {# Update cart button #}
              <div class="flex justify-end pt-2">
                {{ redirectInput('shop/cart') }}
                <button type="submit" class="cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest border-2 border-charcoal text-charcoal px-6 py-3 rounded-full hover:bg-charcoal hover:text-white transition-colors">
                  Update Cart
                </button>
              </div>

            </div>

            {# Right: Summary sidebar #}
            <div class="flex flex-col gap-6">

              {# Shipping estimator #}
              {{ include('shop/cart/_includes/shipping-estimator') }}

              {# Coupon code #}
              <div class="bg-gray-50 rounded-3xl p-6">
                <h2 class="font-anton text-charcoal text-lg mb-4">Promo Code</h2>
                <div class="flex gap-2">
                  {{ input('text', 'couponCode', cart.couponCode, {
                    class: 'flex-1 font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-4 py-3 focus:outline-none focus:border-teal transition-colors bg-white ' ~ (cart.getFirstError('couponCode') ? 'border-red-400' : ''),
                    placeholder: 'Enter code'
                  }) }}
                  <button type="submit" class="cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest bg-charcoal text-white px-5 py-3 rounded-full hover:bg-teal transition-colors whitespace-nowrap">
                    Apply
                  </button>
                </div>
                {% if cart.getFirstError('couponCode') %}
                  <p class="font-hobeaux text-xs text-red-500 mt-2">{{ cart.getFirstError('couponCode') }}</p>
                {% endif %}
              </div>

              {# Order totals + checkout #}
              {% if not cart.hasErrors() %}
                <div class="bg-gray-50 rounded-3xl p-6 flex flex-col gap-3">
                  <h2 class="font-anton text-charcoal text-lg mb-1">Order Summary</h2>

                  <div class="flex justify-between font-hobeaux text-base">
                    <span class="text-charcoal/70">Subtotal</span>
                    <span class="text-charcoal font-bold">{{ cart.itemTotalAsCurrency }}</span>
                  </div>

                  {% if cart.totalShippingCost %}
                    <div class="flex justify-between font-hobeaux text-base">
                      <span class="text-charcoal/70">Shipping</span>
                      <span class="text-charcoal font-bold">{{ cart.totalShippingCostAsCurrency }}</span>
                    </div>
                  {% endif %}

                  {% if cart.totalTax %}
                    <div class="flex justify-between font-hobeaux text-base">
                      <span class="text-charcoal/70">Tax</span>
                      <span class="text-charcoal font-bold">{{ cart.totalTaxAsCurrency }}</span>
                    </div>
                  {% endif %}

                  {% if cart.totalDiscount %}
                    <div class="flex justify-between font-hobeaux text-base">
                      <span class="text-teal font-bold">Discount</span>
                      <span class="text-teal font-bold">{{ cart.totalDiscountAsCurrency }}</span>
                    </div>
                  {% endif %}

                  {% if cart.orderAdjustments|length %}
                    {% for adjustment in cart.orderAdjustments %}
                      <div class="flex justify-between font-hobeaux text-base">
                        <span class="text-charcoal/70">{{ adjustment.name }}{% if adjustment.isEstimated %} <em class="text-sm">(est.)</em>{% endif %}</span>
                        <span class="text-charcoal font-bold">{{ adjustment.amountAsCurrency }}</span>
                      </div>
                    {% endfor %}
                  {% endif %}

                  <hr class="border-gray-200 my-2">

                  <div class="flex justify-between font-anton text-charcoal text-2xl">
                    <span>Total</span>
                    <span>{{ cart.totalPriceAsCurrency }}</span>
                  </div>

                  <a href="{{ url('shop/checkout') }}" class="w-full text-center font-hobeaux font-bold text-base uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors mt-2">
                    Proceed to Checkout
                  </a>

                  <a href="{{ url('shop') }}" class="block text-center font-hobeaux text-sm text-charcoal/60 hover:text-teal transition-colors">
                    &larr; Continue Shopping
                  </a>
                </div>
              {% endif %}

            </div>
          </div>

        </form>

      {% else %}
        {# Empty cart #}
        <div class="text-center py-24">
          <div class="text-8xl mb-6">🐾</div>
          <h2 class="font-anton text-charcoal text-3xl mb-3">Your cart is empty</h2>
          <p class="font-hobeaux text-charcoal/50 mb-8">Looks like your pup hasn't picked anything yet!</p>
          <a href="{{ url('shop') }}" class="inline-block font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white px-8 py-4 rounded-full hover:bg-charcoal transition-colors">
            Browse Treats
          </a>
        </div>
      {% endif %}

    </div>
  </section>

  <script>
  function stepCartQty(btn, direction) {
    const input = btn.parentElement.querySelector('input[type="number"]');
    if (input) {
      input.value = Math.max(0, parseInt(input.value || 0) + direction);
    }
  }
  </script>

{% endblock %}
