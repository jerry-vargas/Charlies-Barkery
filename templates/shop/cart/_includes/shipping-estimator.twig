<!-- Template: {{ _self }}.twig -->
{#
Shipping estimate widget — shown only when no shipping address is on the cart yet.
@var cart \craft\commerce\elements\Order
#}
{% if not cart.getShippingAddress() %}
  {% set usStates = {
    'AL': 'Alabama', 'AK': 'Alaska', 'AZ': 'Arizona', 'AR': 'Arkansas',
    'CA': 'California', 'CO': 'Colorado', 'CT': 'Connecticut', 'DE': 'Delaware',
    'FL': 'Florida', 'GA': 'Georgia', 'HI': 'Hawaii', 'ID': 'Idaho',
    'IL': 'Illinois', 'IN': 'Indiana', 'IA': 'Iowa', 'KS': 'Kansas',
    'KY': 'Kentucky', 'LA': 'Louisiana', 'ME': 'Maine', 'MD': 'Maryland',
    'MA': 'Massachusetts', 'MI': 'Michigan', 'MN': 'Minnesota', 'MS': 'Mississippi',
    'MO': 'Missouri', 'MT': 'Montana', 'NE': 'Nebraska', 'NV': 'Nevada',
    'NH': 'New Hampshire', 'NJ': 'New Jersey', 'NM': 'New Mexico', 'NY': 'New York',
    'NC': 'North Carolina', 'ND': 'North Dakota', 'OH': 'Ohio', 'OK': 'Oklahoma',
    'OR': 'Oregon', 'PA': 'Pennsylvania', 'RI': 'Rhode Island', 'SC': 'South Carolina',
    'SD': 'South Dakota', 'TN': 'Tennessee', 'TX': 'Texas', 'UT': 'Utah',
    'VT': 'Vermont', 'VA': 'Virginia', 'WA': 'Washington', 'WV': 'West Virginia',
    'WI': 'Wisconsin', 'WY': 'Wyoming', 'DC': 'Washington D.C.'
  } %}

  {% set estimatedState = cart.estimatedShippingAddress ? cart.estimatedShippingAddress.administrativeArea : '' %}
  {% set estimatedZip = cart.estimatedShippingAddress ? cart.estimatedShippingAddress.postalCode : '' %}

  <div class="bg-gray-50 rounded-3xl p-6" id="js-estimator-wrap">

    {# Fields view #}
    <div id="js-estimate-fields">
      <h2 class="font-anton text-charcoal text-lg mb-4">Estimate Shipping</h2>

      {{ input('hidden', 'estimatedShippingAddress[countryCode]', 'US') }}
      {{ input('hidden', 'estimatedBillingAddressSameAsShipping', 1) }}
      {{ input('hidden', 'estimatedBillingAddress[countryCode]', 'US') }}

      <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-1">
          <label for="estimate-state" class="font-hobeaux text-sm font-bold text-charcoal">State</label>
          <select
            name="estimatedShippingAddress[stateValue]"
            id="estimate-state"
            class="w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors bg-white"
          >
            <option value="">Select state...</option>
            {% for code, name in usStates %}
              <option value="{{ code }}" {{ estimatedState == code ? 'selected' }}>{{ name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label for="estimate-zip" class="font-hobeaux text-sm font-bold text-charcoal">Zip Code</label>
          {{ input('text', 'estimatedShippingAddress[postalCode]', estimatedZip, {
            id: 'estimate-zip',
            class: 'w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors bg-white',
            placeholder: '28202'
          }) }}
        </div>
      </div>
    </div>

    {# Shipping method results — shown when estimate exists #}
    {% if cart.availableShippingMethodOptions|length and cart.estimatedShippingAddressId %}
      <div id="js-estimate-methods" class="flex flex-col gap-3 mt-4">
        {% for handle, method in cart.availableShippingMethodOptions %}
          <label class="flex items-center justify-between p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:border-teal transition-colors has-[:checked]:border-teal">
            <span class="flex items-center gap-3">
              {{ input('radio', 'shippingMethodHandle', handle, {
                checked: handle == cart.shippingMethodHandle,
                class: 'accent-teal'
              }) }}
              <span class="font-hobeaux text-sm text-charcoal">{{ method.name }}</span>
            </span>
            <span class="font-anton text-charcoal">{{ method.priceForOrder(cart)|commerceCurrency(cart.currency) }}</span>
          </label>
        {% endfor %}
        <button type="button" id="js-show-estimate-fields" class="font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors text-left">
          Change estimate &rsaquo;
        </button>
      </div>
    {% endif %}

  </div>

  <script>
  (function() {
    var $showBtn = document.getElementById('js-show-estimate-fields');
    var $fields = document.getElementById('js-estimate-fields');
    var $methods = document.getElementById('js-estimate-methods');

    // If methods are showing, hide fields initially
    if ($methods && $fields) {
      $fields.classList.add('hidden');
    }

    if ($showBtn) {
      $showBtn.addEventListener('click', function(e) {
        e.preventDefault();
        $fields.classList.toggle('hidden');
        $methods.classList.toggle('hidden');
      });
    }
  })();
  </script>
{% endif %}
