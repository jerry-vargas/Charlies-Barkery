{% extends '_layout.twig' %}
{#
Outputs form for collecting a cart number to be loaded.
#}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-md mx-auto">

        <p class="font-hobeaux text-xs text-teal uppercase tracking-widest mb-2">Cart</p>
        <h1 class="font-anton text-charcoal text-4xl mb-8">Load a Cart</h1>

        <form method="post" action="">
          {{ csrfInput() }}
          {{ actionInput('commerce/cart/load-cart') }}
          {{ redirectInput('shop/cart') }}

          <div class="bg-gray-50 rounded-3xl p-8 flex flex-col gap-5">
            <p class="font-hobeaux text-sm text-charcoal/60">Enter a cart number to restore a previous session.</p>

            <div class="flex flex-col gap-1">
              <label for="number" class="font-hobeaux text-sm font-bold text-charcoal">Cart Number</label>
              {{ input('text', 'number', null, {
                id: 'number',
                class: 'w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors bg-white',
                placeholder: '7e89fh0ew8034...'
              }) }}
            </div>

            <button type="submit" class="cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors">
              Load Cart
            </button>

            <a href="{{ url('shop/cart') }}" class="block text-center font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors">
              &larr; Back to Cart
            </a>
          </div>
        </form>

      </div>
    </div>
  </section>

{% endblock %}
