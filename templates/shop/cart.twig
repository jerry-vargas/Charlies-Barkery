{% set cart = craft.commerce.carts.cart %}

{% extends '_layout.twig' %}

{% block content %}

    {% include '_components/pageHero.twig' with {
        params: {
            eyebrow: 'The Barkery Shop',
            header: 'Your Cart'
        }
    } %}

    <section class="bg-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            {% if cart.totalQty == 0 %}

                {# Empty cart #}
                <div class="text-center py-24 flex flex-col items-center gap-6">
                    <p class="text-6xl">🐾</p>
                    <h2 class="font-anton text-charcoal text-3xl">Your cart is empty</h2>
                    <p class="font-hobeaux text-charcoal/50 text-sm">Looks like your pup hasn't picked anything yet.</p>
                    <a href="{{ url('shop') }}" class="font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white px-8 py-4 rounded-full hover:bg-charcoal transition-colors">
                        Shop Treats
                    </a>
                </div>

            {% else %}

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

                    {# Line items #}
                    <div class="lg:col-span-2 flex flex-col divide-y divide-gray-100">
                        {% for item in cart.lineItems %}
                            {% set variant = item.purchasable %}
                            {% set image = variant.images.one() ?? variant.product.images.one() %}
                            <form method="post" class="flex gap-5 py-6 items-start">
                                {{ csrfInput() }}
                                {{ actionInput('commerce/cart/update-cart') }}

                                {# Image #}
                                <a href="{{ variant.url }}" class="shrink-0 w-24 h-24 rounded-2xl overflow-hidden bg-gray-100">
                                    {% if image %}
                                        <img src="{{ image.getUrl() }}" alt="{{ variant.title }}" class="w-full h-full object-cover"/>
                                    {% endif %}
                                </a>

                                {# Info #}
                                <div class="flex-1 flex flex-col gap-1">
                                    <p class="font-hobeaux text-xs text-teal uppercase tracking-widest">{{ variant.product.title }}</p>
                                    <h3 class="font-anton text-charcoal text-lg leading-tight">{{ variant.title }}</h3>
                                    <p class="font-hobeaux text-charcoal/40 text-xs">SKU: {{ variant.sku }}</p>

                                    {# Qty controls #}
                                    <div class="flex items-center gap-3 mt-3">
                                        <button type="button" onclick="stepQty(this, -1)" class="w-8 h-8 rounded-full border border-gray-200 text-charcoal hover:border-teal hover:text-teal transition-colors flex items-center justify-center font-bold text-sm">−</button>
                                        <input
                                            type="number"
                                            name="lineItems[{{ item.id }}][qty]"
                                            value="{{ item.qty }}"
                                            min="0"
                                            class="w-10 text-center font-hobeaux text-sm text-charcoal border-0 focus:outline-none"
                                        />
                                        <button type="button" onclick="stepQty(this, 1)" class="w-8 h-8 rounded-full border border-gray-200 text-charcoal hover:border-teal hover:text-teal transition-colors flex items-center justify-center font-bold text-sm">+</button>
                                        <button type="submit" class="ml-2 font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors underline underline-offset-2">Update</button>
                                    </div>
                                </div>

                                {# Price + Remove #}
                                <div class="flex flex-col items-end gap-3 shrink-0">
                                    <p class="font-anton text-charcoal text-xl">${{ item.subtotal|number_format(2) }}</p>
                                    <input type="hidden" name="lineItems[{{ item.id }}][remove]" value="0" id="remove-{{ item.id }}">
                                    <button
                                        type="submit"
                                        onclick="document.getElementById('remove-{{ item.id }}').value='1'"
                                        class="font-hobeaux text-xs text-charcoal/30 hover:text-red-400 transition-colors"
                                    >
                                        Remove
                                    </button>
                                </div>
                            </form>
                        {% endfor %}
                    </div>

                    {# Order summary #}
                    <div class="bg-gray-50 rounded-3xl p-8 flex flex-col gap-5 sticky top-6">
                        <h2 class="font-anton text-charcoal text-2xl">Order Summary</h2>

                        <div class="flex flex-col gap-3 text-sm font-hobeaux">
                            <div class="flex justify-between text-charcoal/60">
                                <span>Subtotal ({{ cart.totalQty }} item{{ cart.totalQty != 1 ? 's' }})</span>
                                <span>${{ cart.itemSubtotal|number_format(2) }}</span>
                            </div>
                            {% if cart.totalShippingCost > 0 %}
                            <div class="flex justify-between text-charcoal/60">
                                <span>Shipping</span>
                                <span>${{ cart.totalShippingCost|number_format(2) }}</span>
                            </div>
                            {% endif %}
                            {% if cart.totalDiscount < 0 %}
                            <div class="flex justify-between text-teal">
                                <span>Discount</span>
                                <span>−${{ (cart.totalDiscount * -1)|number_format(2) }}</span>
                            </div>
                            {% endif %}
                        </div>

                        <hr class="border-gray-200"/>

                        <div class="flex justify-between font-anton text-charcoal text-xl">
                            <span>Total</span>
                            <span>${{ cart.totalPrice|number_format(2) }}</span>
                        </div>

                        {# Coupon code #}
                        <form method="post" class="flex gap-2">
                            {{ csrfInput() }}
                            {{ actionInput('commerce/cart/update-cart') }}
                            <input
                                type="text"
                                name="couponCode"
                                placeholder="Coupon code"
                                class="flex-1 font-hobeaux text-sm border border-gray-200 rounded-full px-4 py-2 focus:outline-none focus:border-teal transition-colors"
                            />
                            <button type="submit" class="font-hobeaux text-sm font-bold bg-charcoal text-white px-4 py-2 rounded-full hover:bg-teal transition-colors">
                                Apply
                            </button>
                        </form>

                        <a href="{{ url('shop/checkout') }}" class="w-full bg-teal text-white font-hobeaux font-bold text-sm uppercase tracking-widest py-4 rounded-full hover:bg-charcoal transition-colors text-center">
                            Checkout
                        </a>

                        <a href="{{ url('shop') }}" class="text-center font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors">
                            ← Continue Shopping
                        </a>
                    </div>

                </div>

            {% endif %}

        </div>
    </section>

    <script>
    function stepQty(btn, direction) {
        const input = btn.parentElement.querySelector('input[type="number"]');
        input.value = Math.max(0, parseInt(input.value) + direction);
    }
    </script>

{% endblock %}
