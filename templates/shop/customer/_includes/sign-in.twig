<form method="post" action="" accept-charset="UTF-8" class="flex flex-col gap-5">
  {{ csrfInput() }}
  {{ actionInput('users/login') }}
  {{ redirectInput(redirectUrl ?? '') }}

  <div class="flex flex-col gap-1">
    <label for="loginName" class="font-hobeaux text-sm font-bold text-charcoal">Email / Username</label>
    <input
      type="text"
      name="loginName"
      id="loginName"
      value="{{ craft.app.user.getRememberedUsername() }}"
      placeholder="you@example.com"
      required
      class="w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors"
    >
  </div>

  <div class="flex flex-col gap-1">
    <label for="loginPassword" class="font-hobeaux text-sm font-bold text-charcoal">Password</label>
    <input
      type="password"
      name="password"
      id="loginPassword"
      class="w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors"
    >
  </div>

  <div class="flex items-center justify-between">
    <label class="flex items-center gap-2 font-hobeaux text-sm text-charcoal/60 cursor-pointer">
      <input type="checkbox" name="rememberMe" value="1" class="accent-teal">
      Remember me
    </label>
    <a href="{{ url('shop/customer/forgot-password') }}" class="font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors underline underline-offset-2">
      Forgot password?
    </a>
  </div>

  <button type="submit" class="w-full cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors">
    Sign In
  </button>
</form>
