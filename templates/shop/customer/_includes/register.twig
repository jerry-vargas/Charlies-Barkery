<form method="post" action="" accept-charset="UTF-8" class="flex flex-col gap-5">
  {{ csrfInput() }}
  {{ actionInput('users/save-user') }}
  {{ redirectInput(redirectUrl) }}

  {% macro errorList(errors) %}
    {% if errors %}
      <ul class="mt-1 flex flex-col gap-1">
        {% for error in errors %}
          <li class="font-hobeaux text-xs text-red-500">{{ error }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  {% endmacro %}

  {% from _self import errorList %}

  <div class="flex flex-col gap-1">
    <label for="username" class="font-hobeaux text-sm font-bold text-charcoal">Username</label>
    <input
      type="text"
      name="username"
      id="username"
      value="{{ user is defined ? user.username : '' }}"
      class="w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors"
    >
    {% if user is defined %}{{ errorList(user.getErrors('username')) }}{% endif %}
  </div>

  <div class="flex flex-col gap-1">
    <label for="reg-email" class="font-hobeaux text-sm font-bold text-charcoal">Email address</label>
    <input
      type="email"
      name="email"
      id="reg-email"
      value="{{ user.email ?? cart.email ?? '' }}"
      class="w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors"
    >
    {% if user is defined %}{{ errorList(user.getErrors('email')) }}{% endif %}
  </div>

  <div class="flex flex-col gap-1">
    <label for="savePassword" class="font-hobeaux text-sm font-bold text-charcoal">Password</label>
    <input
      type="password"
      name="password"
      id="savePassword"
      class="w-full font-hobeaux text-sm text-charcoal border border-gray-200 rounded-full px-5 py-3 focus:outline-none focus:border-teal transition-colors"
    >
    {% if user is defined %}{{ errorList(user.getErrors('password')) }}{% endif %}
  </div>

  <button type="submit" class="w-full cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors">
    Create Account
  </button>
</form>
