{% extends '_layout.twig' %}

{% set number = craft.app.request.getRequiredParam('number') %}

{# @var order \craft\commerce\elements\Order #}
{% set order = craft.orders().number(number).one() %}

{% if not order or order.isCompleted == false %}
  {% redirect 'shop/customer' %}
{% endif %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {% if craft.app.request.getParam('success') %}
        <div class="bg-teal/10 border border-teal/30 rounded-2xl px-6 py-5 mb-10 flex items-center gap-4">
          <span class="text-3xl">🐾</span>
          <div>
            <p class="font-anton text-charcoal text-xl">Order placed successfully!</p>
            <p class="font-hobeaux text-sm text-charcoal/60">We'll start baking right away. You'll receive a confirmation email shortly.</p>
          </div>
        </div>
      {% endif %}

      {# Header #}
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-10">
        <div>
          {% if currentUser %}
            <a href="{{ url('shop/customer') }}" class="font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors mb-3 inline-block">
              &larr; View all orders
            </a>
          {% endif %}
          <p class="font-hobeaux text-xs text-teal uppercase tracking-widest mb-1">Order Confirmation</p>
          <h1 class="font-anton text-charcoal text-4xl">{{ order.reference }}</h1>
          <p class="font-hobeaux text-sm text-charcoal/50 mt-1">Placed on {{ order.dateOrdered|date('F j, Y') }}</p>
        </div>
        {% if craft.commerce.pdfs.hasEnabledPdf %}
          <a href="{{ order.getPdfUrl('receipt') }}" download target="_blank" class="font-hobeaux font-bold text-sm uppercase tracking-widest border-2 border-charcoal text-charcoal px-6 py-3 rounded-full hover:bg-charcoal hover:text-white transition-colors self-start">
            Download PDF
          </a>
        {% endif %}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {# Left column: summary + addresses #}
        <div class="flex flex-col gap-6">

          {# Order summary card #}
          <div class="bg-gray-50 rounded-3xl p-6 flex flex-col gap-3">
            <h2 class="font-anton text-charcoal text-xl mb-1">Summary</h2>

            <div class="flex justify-between font-hobeaux text-sm">
              <span class="text-charcoal/60">Customer</span>
              <span class="text-charcoal font-bold">{{ order.email }}</span>
            </div>
            <div class="flex justify-between font-hobeaux text-sm">
              <span class="text-charcoal/60">Payment Status</span>
              <span class="text-charcoal font-bold">{{ order.paidStatusHtml|raw }}</span>
            </div>
            <div class="flex justify-between font-hobeaux text-sm">
              <span class="text-charcoal/60">Amount Paid</span>
              <span class="text-charcoal font-bold">{{ order.totalPaidAsCurrency }}</span>
            </div>
            {% if order.shippingMethodName %}
              <div class="flex justify-between font-hobeaux text-sm">
                <span class="text-charcoal/60">Shipping</span>
                <span class="text-charcoal font-bold">{{ order.shippingMethodName }}</span>
              </div>
            {% endif %}

            <hr class="border-gray-200 my-1">

            <div class="flex justify-between font-anton text-charcoal text-xl">
              <span>Total</span>
              <span>{{ order.totalPriceAsCurrency }}</span>
            </div>

            {% if order.getOutstandingBalance() - order.getTotalAuthorized() > 0 %}
              <a href="{{ siteUrl('shop/checkout/pay-static', {
                number: order.number,
                email: order.email,
                paymentCurrency: order.paymentCurrency
              }) }}" class="w-full text-center font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors mt-2">
                Make Payment
              </a>
            {% endif %}
          </div>

          {# Shipping address #}
          <div class="bg-gray-50 rounded-3xl p-6">
            <h2 class="font-anton text-charcoal text-xl mb-3">Shipping Address</h2>
            {% if order.shippingAddress %}
              <div class="font-hobeaux text-sm text-charcoal/70 leading-relaxed">
                {{ craft.app.addresses.formatAddress(order.shippingAddress)|raw }}
              </div>
            {% else %}
              <p class="font-hobeaux text-sm text-charcoal/40">No shipping address on file.</p>
            {% endif %}
          </div>

          {# Billing address #}
          <div class="bg-gray-50 rounded-3xl p-6">
            <h2 class="font-anton text-charcoal text-xl mb-3">Billing Address</h2>
            {% if order.billingAddress %}
              <div class="font-hobeaux text-sm text-charcoal/70 leading-relaxed">
                {{ craft.app.addresses.formatAddress(order.billingAddress)|raw }}
              </div>
            {% else %}
              <p class="font-hobeaux text-sm text-charcoal/40">No billing address on file.</p>
            {% endif %}
          </div>

        </div>

        {# Right column: line items + totals + transactions #}
        <div class="lg:col-span-2 flex flex-col gap-6">

          {# Line items #}
          <div class="bg-gray-50 rounded-3xl p-6">
            <h2 class="font-anton text-charcoal text-xl mb-4">Items</h2>

            <div class="flex flex-col divide-y divide-gray-200">
              {% for item in order.lineItems %}
                <div class="py-4 flex justify-between items-start gap-4 {{ loop.first ? 'pt-0' }}">
                  <div class="flex-1">
                    <p class="font-hobeaux font-bold text-sm text-charcoal">{{ item.description }}</p>
                    <p class="font-hobeaux text-xs text-charcoal/40 mt-0.5">SKU: {{ item.sku }}</p>
                    {% if item.qty > 1 %}
                      <p class="font-hobeaux text-xs text-charcoal/60 mt-1">Qty: {{ item.qty }}</p>
                    {% endif %}
                    {% if item.note %}
                      <p class="font-hobeaux text-xs text-charcoal/60 mt-1">Note: {{ item.note }}</p>
                    {% endif %}
                    {% if item.adjustments|length %}
                      <div class="mt-2 flex flex-col gap-1">
                        {% for adjustment in item.adjustments %}
                          <div class="flex justify-between font-hobeaux text-xs text-charcoal/50">
                            <span>{{ adjustment.name }}</span>
                            <span>{{ adjustment.amountAsCurrency }}</span>
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                  <div class="text-right shrink-0">
                    {% if item.onPromotion %}
                      <p class="font-hobeaux text-xs text-charcoal/40 line-through">{{ item.priceAsCurrency }}</p>
                      <p class="font-anton text-charcoal text-lg">{{ item.promotionalPriceAsCurrency }}</p>
                    {% else %}
                      <p class="font-anton text-charcoal text-lg">{{ item.priceAsCurrency }}</p>
                    {% endif %}
                    {% if item.qty > 1 %}
                      <p class="font-hobeaux text-xs text-charcoal/60">{{ item.subtotalAsCurrency }} total</p>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>

            {# Totals breakdown #}
            <div class="border-t border-gray-200 mt-4 pt-4 flex flex-col gap-2">
              <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
                <span>Subtotal</span>
                <span>{{ order.itemSubtotalAsCurrency }}</span>
              </div>
              <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
                <span>Shipping</span>
                <span>{{ order.totalShippingCostAsCurrency }}</span>
              </div>
              {% if order.totalTax %}
                <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
                  <span>Tax</span>
                  <span>{{ order.totalTaxAsCurrency }}</span>
                </div>
              {% endif %}
              {% if order.totalDiscount %}
                <div class="flex justify-between font-hobeaux text-sm text-teal">
                  <span>Discount</span>
                  <span>{{ order.totalDiscountAsCurrency }}</span>
                </div>
              {% endif %}

              {% if order.orderAdjustments|length %}
                {% for adjustment in order.orderAdjustments %}
                  <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
                    <span>{{ adjustment.name }}</span>
                    <span>{{ adjustment.amountAsCurrency }}</span>
                  </div>
                {% endfor %}
              {% endif %}

              <hr class="border-gray-200 my-1">

              <div class="flex justify-between font-anton text-charcoal text-xl">
                <span>Total</span>
                <span>{{ order.totalPriceAsCurrency }}</span>
              </div>
              {% if order.outstandingBalance > 0 %}
                <div class="flex justify-between font-hobeaux text-sm text-bronze">
                  <span>Outstanding Balance</span>
                  <span>{{ order.outstandingBalanceAsCurrency }}</span>
                </div>
              {% endif %}
            </div>
          </div>

          {# Transactions #}
          {% if order.transactions|length %}
            <div class="bg-gray-50 rounded-3xl p-6">
              <h2 class="font-anton text-charcoal text-xl mb-4">Transactions</h2>
              <div class="flex flex-col gap-3">
                {% for transaction in order.transactions %}
                  <div class="flex items-center justify-between gap-4 font-hobeaux text-sm">
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide {{ transaction.status == 'success' ? 'bg-teal/10 text-teal' : 'bg-red-50 text-red-500' }}">
                      {{ transaction.status }}
                    </span>
                    <span class="flex-1 text-charcoal">
                      {{ transaction.amountAsCurrency }} {{ transaction.currency }} — {{ transaction.type }}
                    </span>
                    <span class="text-charcoal/40 text-xs">{{ transaction.dateCreated|date('M j, Y') }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

        </div>

      </div>
    </div>
  </section>

{% endblock %}
