<!-- Template: {{ _self }}.twig -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

  {# Variant Image #}
  <div class="rounded-3xl overflow-hidden bg-gray-100 aspect-square sticky top-6">
    {% set variantImg = activeVariant.images.one() ?? product.featuredImage.one() ?? product.images.one() ?? null %}
    {% if variantImg %}
      <img src="{{ variantImg.getUrl() }}" alt="{{ activeVariant.title }}" class="w-full h-full object-cover">
    {% else %}
      <div class="w-full h-full flex items-center justify-center text-9xl">🐾</div>
    {% endif %}
  </div>

  {# Variant Info #}
  <div class="flex flex-col gap-8">

    <div>
      <p class="font-hobeaux text-sm font-bold text-teal uppercase tracking-widest mb-3">{{ product.type.name }}</p>
      <h1 class="font-anton text-charcoal text-5xl lg:text-6xl leading-tight">{{ activeVariant.title }}</h1>
    </div>

    <div class="flex items-baseline gap-4">
      {% if activeVariant.onPromotion %}
        <span class="font-anton text-charcoal/40 text-3xl line-through">{{ activeVariant.priceAsCurrency }}</span>
        <span class="font-anton text-charcoal text-5xl">{{ activeVariant.salePriceAsCurrency }}</span>
        <span class="font-hobeaux text-sm font-bold text-teal bg-teal/10 px-3 py-1 rounded-full">Sale</span>
      {% else %}
        <span class="font-anton text-charcoal text-5xl">{{ activeVariant.priceAsCurrency }}</span>
      {% endif %}
    </div>

    {{ sprig('_sprig/add-to-cart', {productId: product.id, variantId: activeVariant.id}) }}

    {# Nutritional Info — variant supersedes product #}
    {% set nutritionContent = activeVariant.nutrition ?? product.nutrition ?? null %}
    {% if nutritionContent %}
      <div class="border-t border-gray-200 pt-6">
        <h3 class="font-hobeaux font-bold text-base text-charcoal mb-3">Nutritional Info</h3>
        <div class="font-hobeaux text-sm text-charcoal/70 prose prose-sm max-w-none">
          {{ nutritionContent }}
        </div>
      </div>
    {% endif %}

    <a href="{{ product.url }}" class="inline-flex items-center gap-2 font-hobeaux font-bold text-base text-charcoal/70 hover:text-teal transition-colors">
      &larr; Back to {{ product.title }}
    </a>

  </div>

</div>
