<!-- Template: {{ _self }}.twig -->
{# @var products  \craft\commerce\elements\Product[] #}
{# @var pageInfo  \craft\web\twig\variables\Paginate #}

{% if pageInfo.totalPages > 1 %}
  <div class="mt-12 flex flex-col items-center gap-4">

    <p class="font-hobeaux text-sm text-charcoal/50">
      Showing {{ products|length }} of {{ pageInfo.total }} treats
    </p>

    <div class="flex items-center gap-2">

      {% if pageInfo.currentPage != 1 %}
        <a href="{{ pageInfo.firstUrl }}" class="font-hobeaux text-sm text-charcoal/40 hover:text-teal transition-colors px-3 py-2">
          &laquo;
        </a>
      {% endif %}

      {% if pageInfo.prevUrl %}
        <a href="{{ pageInfo.prevUrl }}" class="font-hobeaux text-sm font-bold text-charcoal/60 hover:text-teal transition-colors px-3 py-2">
          &larr; Prev
        </a>
      {% endif %}

      {% for page, url in pageInfo.getPrevUrls(3) %}
        <a href="{{ url }}" class="font-hobeaux text-sm text-charcoal/50 hover:text-teal transition-colors w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
          {{ page }}
        </a>
      {% endfor %}

      <span class="font-hobeaux text-sm font-bold text-white bg-teal w-9 h-9 flex items-center justify-center rounded-full">
        {{ pageInfo.currentPage }}
      </span>

      {% for page, url in pageInfo.getNextUrls(3) %}
        <a href="{{ url }}" class="font-hobeaux text-sm text-charcoal/50 hover:text-teal transition-colors w-9 h-9 flex items-center justify-center rounded-full hover:bg-gray-100">
          {{ page }}
        </a>
      {% endfor %}

      {% if pageInfo.nextUrl %}
        <a href="{{ pageInfo.nextUrl }}" class="font-hobeaux text-sm font-bold text-charcoal/60 hover:text-teal transition-colors px-3 py-2">
          Next &rarr;
        </a>
      {% endif %}

      {% if pageInfo.currentPage != pageInfo.totalPages %}
        <a href="{{ pageInfo.lastUrl }}" class="font-hobeaux text-sm text-charcoal/40 hover:text-teal transition-colors px-3 py-2">
          &raquo;
        </a>
      {% endif %}

    </div>
  </div>
{% else %}
  <p class="font-hobeaux text-sm text-charcoal/40 text-center mt-10">
    Showing all {{ pageInfo.total }} {{ pageInfo.total == 1 ? 'treat' : 'treats' }}
  </p>
{% endif %}
