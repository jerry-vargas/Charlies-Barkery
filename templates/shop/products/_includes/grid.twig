<!-- Template: {{ _self }}.twig -->
{# @var products \craft\commerce\elements\Product[] #}

{% if products|length %}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    {% for product in products %}
      {% set variants = product.getVariants() %}
      {% set isSingle = variants|length == 1 %}
      {% set variant = variants[0] %}
      {% set image = product.featuredImage.one() ?? product.images.one() ?? null %}

      <div class="bg-gray-50 rounded-3xl overflow-hidden flex flex-col group">

        {# Image #}
        <a href="{{ product.url }}" class="block aspect-square overflow-hidden bg-gray-100">
          {% if image %}
            <img src="{{ image.getUrl() }}" alt="{{ product.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          {% else %}
            <div class="w-full h-full flex items-center justify-center text-6xl">🐾</div>
          {% endif %}
        </a>

        {# Info #}
        <div class="p-5 flex flex-col flex-1 gap-3">
          <div>
            <p class="font-hobeaux text-xs text-teal uppercase tracking-widest mb-1">{{ product.type.name }}</p>
            <a href="{{ product.url }}" class="font-anton text-charcoal text-xl leading-tight hover:text-teal transition-colors">
              {{ product.title }}
            </a>
          </div>

          {# Price #}
          <div class="mt-auto">
            {% if isSingle %}
              {% if variant.onPromotion %}
                <span class="font-hobeaux text-xs text-charcoal/40 line-through mr-1">{{ variant.priceAsCurrency }}</span>
                <span class="font-anton text-charcoal text-lg">{{ variant.salePriceAsCurrency }}</span>
              {% else %}
                <span class="font-anton text-charcoal text-lg">{{ variant.priceAsCurrency }}</span>
              {% endif %}
            {% else %}
              {# Price range for multi-variant #}
              {% set prices = variants|map(v => v.price)|sort %}
              <span class="font-hobeaux text-sm text-charcoal/60">From </span>
              <span class="font-anton text-charcoal text-lg">{{ prices|first|commerceCurrency(cart.currency) }}</span>
            {% endif %}
          </div>

          {# CTA #}
          {% if isSingle and variant.availableForPurchase %}
            <form method="post">
              {{ csrfInput() }}
              {{ actionInput('commerce/cart/update-cart') }}
              {{ successMessageInput(product.title ~ ' added to your cart!') }}
              {{ redirectInput('shop/cart') }}
              {{ hiddenInput('purchasables[0][id]', variant.id) }}
              {{ hiddenInput('purchasables[0][qty]', 1) }}
              <button type="submit" class="w-full cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white py-3 rounded-full hover:bg-charcoal transition-colors">
                Add to Cart
              </button>
            </form>
          {% else %}
            <a href="{{ product.url }}" class="block w-full text-center font-hobeaux font-bold text-sm uppercase tracking-widest border-2 border-teal text-teal py-3 rounded-full hover:bg-teal hover:text-white transition-colors">
              {{ variants|length > 1 ? 'Choose Options' : 'View Product' }}
            </a>
          {% endif %}
        </div>

      </div>
    {% endfor %}
  </div>

{% else %}
  <div class="text-center py-24">
    <div class="text-7xl mb-6">🐾</div>
    <p class="font-anton text-charcoal text-2xl mb-2">No treats found</p>
    <p class="font-hobeaux text-charcoal/50 mb-6">Try a different search term.</p>
    <a href="{{ url('shop/products') }}" class="inline-block font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white px-8 py-4 rounded-full hover:bg-charcoal transition-colors">
      View All Treats
    </a>
  </div>
{% endif %}
