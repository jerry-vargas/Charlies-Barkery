{% extends '_layout.twig' %}

{% if currentUser %}
  {% redirect 'shop/checkout/addresses' %}
{% endif %}

{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% if not cart.email %}
  {% redirect 'shop/checkout' %}
{% endif %}

{% set userExistsButCantLogin = craft.users
  .email(cart.email ?? 'NULL')
  .status(['locked','suspended','pending'])
  .one() %}

{% if userExistsButCantLogin %}
  {% redirect 'shop/checkout/addresses' %}
{% endif %}

{% set userExists = craft.users.email(cart.email ?? 'NULL').one() %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-gray-50 min-h-screen py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {# Step indicator #}
      <div class="flex items-center gap-2 font-hobeaux text-sm text-charcoal/40 mb-10">
        <a href="{{ url('shop/checkout') }}" class="hover:text-teal transition-colors">Email</a>
        <span>&rarr;</span>
        <span class="text-teal font-bold">Account</span>
        <span>&rarr;</span>
        <span>Address</span>
        <span>&rarr;</span>
        <span>Shipping</span>
        <span>&rarr;</span>
        <span>Payment</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

        {# Main panel #}
        <div class="lg:col-span-2 flex flex-col gap-5">

          {# Sign in / Register card #}
          <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
            {% if userExists and userExists.getIsCredentialed() %}
              <p class="font-hobeaux text-sm font-bold text-teal uppercase tracking-widest mb-2">Step 2</p>
              <h1 class="font-anton text-charcoal text-4xl mb-2">Welcome back!</h1>
              <p class="font-hobeaux text-base text-charcoal/60 mb-8">Sign in to {{ cart.email }} to continue.</p>
              {% include 'shop/customer/_includes/sign-in' with { redirectUrl: 'shop/checkout/addresses' } %}
            {% else %}
              <p class="font-hobeaux text-sm font-bold text-teal uppercase tracking-widest mb-2">Step 2</p>
              <h1 class="font-anton text-charcoal text-4xl mb-2">Create an account</h1>
              <p class="font-hobeaux text-base text-charcoal/60 mb-8">Save your details for faster checkout next time.</p>
              {% include 'shop/customer/_includes/register' with { redirectUrl: 'shop/checkout/addresses' } %}
            {% endif %}
          </div>

          {# Guest option — prominent #}
          <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="font-hobeaux font-bold text-charcoal text-base">No account? No problem.</p>
              <p class="font-hobeaux text-sm text-charcoal/60 mt-1">You can complete your order as a guest.</p>
            </div>
            <a href="{{ url('shop/checkout/addresses') }}"
              class="shrink-0 inline-flex items-center gap-2 font-hobeaux font-bold text-base uppercase tracking-widest border-2 border-charcoal text-charcoal px-8 py-4 rounded-full hover:bg-charcoal hover:text-white transition-colors whitespace-nowrap">
              Continue as Guest &rarr;
            </a>
          </div>

        </div>

        {# Order summary sidebar #}
        <div>
          {{ include('shop/checkout/_includes/order-summary') }}
        </div>

      </div>
    </div>
  </section>

{% endblock %}
