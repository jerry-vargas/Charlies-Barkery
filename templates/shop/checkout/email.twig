{% if currentUser %}
  {% redirect 'shop/checkout/addresses' %}
{% endif %}

{% extends '_layout.twig' %}

{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-gray-50 min-h-screen py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {# Step indicator #}
      <div class="flex items-center gap-2 font-hobeaux text-sm text-charcoal/40 mb-10">
        <span class="text-teal font-bold">Email</span>
        <span>&rarr;</span>
        <span>Account</span>
        <span>&rarr;</span>
        <span>Address</span>
        <span>&rarr;</span>
        <span>Shipping</span>
        <span>&rarr;</span>
        <span>Payment</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

        {# Main form #}
        <div class="lg:col-span-2">
          <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
            <p class="font-hobeaux text-sm font-bold text-teal uppercase tracking-widest mb-2">Step 1</p>
            <h1 class="font-anton text-charcoal text-4xl mb-2">What's your email?</h1>
            <p class="font-hobeaux text-base text-charcoal/60 mb-8">We'll use this to keep you updated on your order.</p>

            <form method="post" action="">
              {{ csrfInput() }}
              {{ actionInput('commerce/cart/update-cart') }}
              {{ redirectInput('shop/checkout/register-signin') }}
              {{ successMessageInput('Email address updated.') }}

              <div class="flex flex-col gap-2 mb-6">
                <label for="email" class="font-hobeaux text-base font-bold text-charcoal">Email address</label>
                {{ input('email', 'email', cart.email, {
                  id: 'email',
                  placeholder: 'you@example.com',
                  class: 'w-full font-hobeaux text-base text-charcoal border-2 border-gray-200 rounded-full px-6 py-4 focus:outline-none focus:border-teal transition-colors bg-gray-50'
                }) }}
              </div>

              <button type="submit"
                class="w-full cursor-pointer font-hobeaux font-bold text-base uppercase tracking-widest bg-teal text-white py-5 rounded-full hover:bg-charcoal transition-colors shadow-md shadow-teal/20">
                Continue &rarr;
              </button>
            </form>
          </div>
        </div>

        {# Order summary sidebar #}
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 flex flex-col gap-4">
          <h2 class="font-anton text-charcoal text-xl">Order Summary</h2>

          <div class="flex flex-col divide-y divide-gray-100">
            {% for item in cart.lineItems %}
              <div class="py-3 flex justify-between gap-4">
                <div class="flex-1">
                  <p class="font-hobeaux font-bold text-charcoal text-sm leading-snug">{{ item.description }}</p>
                  {% if item.qty > 1 %}
                    <p class="font-hobeaux text-xs text-charcoal/50 mt-0.5">Qty: {{ item.qty }}</p>
                  {% endif %}
                </div>
                <p class="font-anton text-charcoal text-lg shrink-0">{{ item.subtotalAsCurrency }}</p>
              </div>
            {% endfor %}
          </div>

          <div class="border-t-2 border-gray-100 pt-4 flex justify-between font-anton text-charcoal text-2xl">
            <span>Total</span>
            <span>{{ cart.totalPriceAsCurrency }}</span>
          </div>

          <a href="{{ url('shop/cart') }}" class="block text-center font-hobeaux text-sm text-charcoal/50 hover:text-teal transition-colors">
            &larr; Edit cart
          </a>
        </div>

      </div>
    </div>
  </section>

{% endblock %}
