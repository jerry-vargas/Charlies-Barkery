<!-- Template: {{ _self }}.twig -->

{% set showShippingAddress = showShippingAddress ?? false %}
{% set showShippingMethod = showShippingMethod ?? false %}

<div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 flex flex-col gap-4 sticky top-6">
  <h2 class="font-anton text-charcoal text-xl">Order Summary</h2>

  <div class="flex flex-col divide-y divide-gray-100">
    {% for item in cart.lineItems %}
      <div class="py-3 flex justify-between items-start gap-3">
        <div class="flex-1 min-w-0">
          <p class="font-hobeaux font-bold text-sm text-charcoal leading-snug">{{ item.description }}</p>
          {% if item.qty > 1 %}
            <p class="font-hobeaux text-xs text-charcoal/50 mt-0.5">Qty: {{ item.qty }}</p>
          {% endif %}
        </div>
        <p class="font-anton text-charcoal text-lg shrink-0">{{ item.subtotal|currency(cart.currency) }}</p>
      </div>
    {% else %}
      <p class="font-hobeaux text-sm text-charcoal/50 py-3">
        Your cart is empty.
        <a href="{{ url('shop/products') }}" class="text-teal underline underline-offset-2">Shop now</a>
      </p>
    {% endfor %}
  </div>

  {% if showShippingAddress %}
    <div class="pt-3 border-t border-gray-100">
      <p class="font-hobeaux text-xs font-bold text-teal uppercase tracking-widest mb-1">Shipping To</p>
      {% if cart.shippingAddress %}
        <div class="font-hobeaux text-sm text-charcoal/70 leading-relaxed">
          {{ craft.app.addresses.formatAddress(cart.shippingAddress)|raw }}
        </div>
      {% else %}
        <p class="font-hobeaux text-sm text-charcoal/40">No address selected.</p>
      {% endif %}
      <a href="{{ url('shop/checkout/addresses') }}" class="font-hobeaux text-xs font-bold text-teal hover:underline mt-1 inline-block">Change</a>
    </div>
  {% endif %}

  {% if showShippingMethod %}
    <div class="pt-3 border-t border-gray-100">
      <p class="font-hobeaux text-xs font-bold text-teal uppercase tracking-widest mb-1">Shipping Method</p>
      {% if not cart.shippingMethodName %}
        <a href="{{ url('shop/checkout/shipping') }}" class="font-hobeaux text-sm text-teal hover:underline">Choose a method</a>
      {% else %}
        <p class="font-hobeaux text-sm text-charcoal/70">{{ cart.shippingMethodName }}</p>
        <a href="{{ url('shop/checkout/shipping') }}" class="font-hobeaux text-xs font-bold text-teal hover:underline mt-0.5 inline-block">Change</a>
      {% endif %}
    </div>
  {% endif %}

  <div class="flex flex-col gap-2 pt-3 border-t border-gray-100">
    <div class="flex justify-between font-hobeaux text-sm text-charcoal/70">
      <span>Subtotal</span>
      <span class="font-bold text-charcoal">{{ cart.itemSubtotalAsCurrency }}</span>
    </div>
    <div class="flex justify-between font-hobeaux text-sm text-charcoal/70">
      <span>Shipping</span>
      <span class="font-bold text-charcoal">{{ cart.totalShippingCost ? cart.totalShippingCostAsCurrency : '—' }}</span>
    </div>
    {% if cart.totalTax %}
      <div class="flex justify-between font-hobeaux text-sm text-charcoal/70">
        <span>Tax</span>
        <span class="font-bold text-charcoal">{{ cart.totalTaxAsCurrency }}</span>
      </div>
    {% endif %}
    {% if cart.totalDiscount %}
      <div class="flex justify-between font-hobeaux text-sm text-teal font-bold">
        <span>Discount</span>
        <span>{{ cart.totalDiscount|commerceCurrency(cart.currency) }}</span>
      </div>
    {% endif %}
  </div>

  <div class="flex justify-between font-anton text-charcoal text-2xl pt-3 border-t-2 border-gray-100">
    <span>Total</span>
    <span>{{ cart.totalPrice|commerceCurrency(cart.currency) }}</span>
  </div>

  {% if cart.currency != cart.paymentCurrency and cart.totalPrice == cart.getOutstandingBalance() %}
    <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
      <span>Payment ({{ cart.paymentCurrency }})</span>
      <span>{{ cart.totalPrice|commerceCurrency(cart.paymentCurrency, convert=true) }}</span>
    </div>
  {% endif %}

  {% if cart.hasOutstandingBalance and cart.totalPrice != cart.getOutstandingBalance() %}
    <div class="flex justify-between font-hobeaux text-sm text-charcoal/60">
      <span>Outstanding Balance</span>
      <span>{{ cart.outstandingBalance|commerceCurrency(cart.paymentCurrency, convert=true) }}</span>
    </div>
  {% endif %}
</div>
