{% extends '_layout.twig' %}

{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% set paymentSources = craft.commerce.paymentSources.getAllPaymentSourcesByCustomerId(currentUser.id ?? null) %}
{% set availableGateways = cart.availableGateways %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  <section class="bg-gray-50 min-h-screen py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {# Step indicator #}
      <div class="flex items-center gap-2 font-hobeaux text-sm text-charcoal/40 mb-10">
        <a href="{{ url('shop/checkout') }}" class="hover:text-teal transition-colors">Email</a>
        <span>&rarr;</span>
        <a href="{{ url('shop/checkout/register-signin') }}" class="hover:text-teal transition-colors">Account</a>
        <span>&rarr;</span>
        <a href="{{ url('shop/checkout/addresses') }}" class="hover:text-teal transition-colors">Address</a>
        <span>&rarr;</span>
        <a href="{{ url('shop/checkout/shipping') }}" class="hover:text-teal transition-colors">Shipping</a>
        <span>&rarr;</span>
        <span class="text-teal font-bold">Payment</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

        <div class="lg:col-span-2">
          <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
            <p class="font-hobeaux text-sm font-bold text-teal uppercase tracking-widest mb-2">Step 5</p>
            <h1 class="font-anton text-charcoal text-4xl mb-8">How would you like to pay?</h1>

            {% if availableGateways is empty %}
              <p class="font-hobeaux text-base text-charcoal/60">No payment methods are available.</p>
            {% else %}
              <form method="post" action="">
                {{ csrfInput() }}
                {{ actionInput('commerce/cart/update-cart') }}
                {{ redirectInput(siteUrl('shop/checkout/options')) }}
                {{ successMessageInput('Payment method selected.') }}

                {{ include('shop/checkout/_includes/gateways', {
                  availableGateways: availableGateways,
                  paymentSources: paymentSources
                }) }}

                {{ include('shop/checkout/_includes/currencies') }}

                <div class="mt-8">
                  <button type="submit" name="submit"
                    class="w-full cursor-pointer font-hobeaux font-bold text-base uppercase tracking-widest bg-teal text-white py-5 rounded-full hover:bg-charcoal transition-colors shadow-md shadow-teal/20">
                    Continue &rarr;
                  </button>
                </div>
              </form>
            {% endif %}
          </div>
        </div>

        <div>
          {{ include('shop/checkout/_includes/order-summary', {
            showShippingAddress: true,
            showShippingMethod: true
          }) }}
        </div>

      </div>
    </div>
  </section>

{% endblock %}
