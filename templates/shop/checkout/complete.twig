{% extends '_layout.twig' %}

{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% block content %}
  <!-- Template: {{ _self }}.twig -->

  {% if not cart.gateway %}
    {% redirect 'shop/checkout/payment-method' %}
  {% endif %}

  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-md mx-auto text-center">

        <p class="font-hobeaux text-xs text-teal uppercase tracking-widest mb-2">Almost there</p>
        <h1 class="font-anton text-charcoal text-4xl mb-4">Review your order</h1>
        <p class="font-hobeaux text-sm text-charcoal/60 mb-10">By clicking below you confirm your order and agree to our terms.</p>

        <div class="mb-8">
          {% include 'shop/checkout/_includes/order-summary' %}
        </div>

        <form id="completeForm" method="post" action="">
          {{ csrfInput() }}
          {{ actionInput('commerce/cart/complete') }}
          {{ redirectInput(siteUrl('shop/customer/order', {
            number: cart.number,
            success: 'true'
          })) }}

          <button type="submit" class="w-full cursor-pointer font-hobeaux font-bold text-sm uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors">
            Place Order
          </button>
        </form>

        <a href="{{ url('shop/checkout/payment') }}" class="block mt-4 font-hobeaux text-xs text-charcoal/40 hover:text-teal transition-colors">
          &larr; Back to payment
        </a>

      </div>
    </div>
  </section>

{% endblock %}
