{# Nutritional Info #}
<div class="flex flex-col gap-6">
    <div>
        <p class="font-hobeaux text-teal uppercase tracking-widest text-xs mb-3">What's inside</p>
        <h2 class="font-anton text-charcoal text-3xl sm:text-4xl">Nutritional Info</h2>
    </div>

    {# Stat cards #}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-2xl p-5 flex flex-col gap-1">
            <span class="font-hobeaux text-xs text-charcoal/40 uppercase tracking-widest">Calories</span>
            <span class="font-anton text-charcoal text-3xl">120</span>
            <span class="font-hobeaux text-xs text-charcoal/40">kcal</span>
        </div>
        <div class="bg-gray-50 rounded-2xl p-5 flex flex-col gap-1">
            <span class="font-hobeaux text-xs text-charcoal/40 uppercase tracking-widest">Protein</span>
            <span class="font-anton text-charcoal text-3xl">4</span>
            <span class="font-hobeaux text-xs text-charcoal/40">grams</span>
        </div>
        <div class="bg-gray-50 rounded-2xl p-5 flex flex-col gap-1">
            <span class="font-hobeaux text-xs text-charcoal/40 uppercase tracking-widest">Fat</span>
            <span class="font-anton text-charcoal text-3xl">5</span>
            <span class="font-hobeaux text-xs text-charcoal/40">grams</span>
        </div>
        <div class="bg-gray-50 rounded-2xl p-5 flex flex-col gap-1">
            <span class="font-hobeaux text-xs text-charcoal/40 uppercase tracking-widest">Carbs</span>
            <span class="font-anton text-charcoal text-3xl">14</span>
            <span class="font-hobeaux text-xs text-charcoal/40">grams</span>
        </div>
    </div>

    {# Detailed breakdown #}
    <div class="rounded-2xl border border-gray-100 overflow-hidden">
        <div class="flex justify-between items-center px-6 py-4 bg-white border-b border-gray-100">
            <span class="font-hobeaux text-sm text-charcoal">Fiber</span>
            <span class="font-hobeaux text-sm font-bold text-charcoal">1g</span>
        </div>
        <div class="flex justify-between items-center px-6 py-4 bg-white border-b border-gray-100">
            <span class="font-hobeaux text-sm text-charcoal">Sugar</span>
            <span class="font-hobeaux text-sm font-bold text-charcoal">2g</span>
        </div>
        <div class="flex justify-between items-center px-6 py-4 bg-white border-b border-gray-100">
            <span class="font-hobeaux text-sm text-charcoal">Sodium</span>
            <span class="font-hobeaux text-sm font-bold text-charcoal">80mg</span>
        </div>
        <div class="flex justify-between items-center px-6 py-4 bg-white">
            <span class="font-hobeaux text-sm text-charcoal">Calcium</span>
            <span class="font-hobeaux text-sm font-bold text-charcoal">20mg</span>
        </div>
    </div>

    <p class="font-hobeaux text-xs text-charcoal/30">Per serving. Values are approximate and may vary by batch.</p>
</div>
