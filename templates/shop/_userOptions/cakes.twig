<div class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
        <label for="pet-color" class="font-hobeaux text-xs uppercase tracking-widest text-charcoal/40">
            Color
        </label>
        <select
                id="cake-color"
                name="options[color]"
                class="w-full border border-gray-200 rounded-2xl px-4 py-3 font-hobeaux text-charcoal text-sm appearance-none bg-white focus:outline-none focus:border-teal transition-colors cursor-pointer"
        >
            <option value="red">Red</option>
            <option value="orange">Orange</option>
            <option value="yellow">Yellow</option>
            <option value="green">Green</option>
            <option value="blue">Blue</option>
            <option value="purple">Purple</option>
            <option value="pink">Pink</option>
        </select>
        <label for="pet-age" class="font-hobeaux text-xs uppercase tracking-widest text-charcoal/40">
            Your Pet's age
        </label>
        <select
                id="cake-color"
                name="options[age]"
                class="w-full border border-gray-200 rounded-2xl px-4 py-3 font-hobeaux text-charcoal text-sm appearance-none bg-white focus:outline-none focus:border-teal transition-colors cursor-pointer"
        >
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="10">10</option>
            <option value="11">11</option>
            <option value="12">12</option>
            <option value="13">13</option>
            <option value="14">14</option>
            <option value="15+">15+</option>
        </select>

    </div>
    <div class="flex flex-col gap-2">
        <label for="additional-message" class="font-hobeaux text-xs uppercase tracking-widest text-charcoal/40">
            Any additional notes or special requests?
        </label>
        <input
                type="text"
                id="additional-message"
                name="note"
                placeholder="e.g. Happy Birthday Biscuit!"
                class="w-full border border-gray-200 rounded-2xl px-4 py-3 font-hobeaux text-charcoal text-sm placeholder:text-charcoal/30 focus:outline-none focus:border-teal transition-colors"
        >
    </div>
</div>
