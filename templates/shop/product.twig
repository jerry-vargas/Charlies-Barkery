{% extends '_layout.twig' %}

{# @var product \craft\commerce\elements\Product #}

{% set selectedVariantId = craft.app.request.getQueryParam('variant')|number_format(0, '', '') %}
{% set variants = product.getVariants() %}

{# Find the pre-selected variant — fall back to first #}
{% set activeVariant = variants[0] %}
{% for v in variants %}
  {% if v.id == selectedVariantId %}
    {% set activeVariant = v %}
  {% endif %}
{% endfor %}

{% block content %}
  <!-- Template: {{ _self }} -->

  <section class="bg-gray-50 py-10 lg:py-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      {# Breadcrumb nav #}
      {% set category = product.productCategories.one() %}
      <nav class="flex items-center gap-2 font-hobeaux text-sm text-charcoal/50 mb-10">
        <a href="{{ url('shop') }}" class="hover:text-teal transition-colors font-bold text-charcoal/70">Shop</a>
        {% if category %}
          <span>/</span>
          <a href="{{ category.url }}" class="hover:text-teal transition-colors font-bold text-charcoal/70">{{ category.title }}</a>
        {% endif %}
        <span>/</span>
        <span class="text-charcoal/60 truncate">{{ product.title }}</span>
      </nav>

      {% if product.type.handle in ['cookie', 'cookiePackage', 'cookie2Pack'] %}

        {% if selectedVariantId > 0 %}
          {% include 'shop/products/_includes/cookie-variant-detail' %}
        {% else %}
          {% include 'shop/products/_includes/cookie-grid' %}
        {% endif %}

      {% else %}

        {# ── All other products: standard two-column layout ── #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

          {# Product Image #}
          <div class="rounded-3xl overflow-hidden bg-gray-100 aspect-square sticky top-6">
            {% set image = activeVariant.images.one() ?? product.featuredImage.one() ?? product.images.one() ?? null %}
            {% if image %}
              <img id="product-image" src="{{ image.getUrl() }}" alt="{{ product.title }}" class="w-full h-full object-cover">
            {% else %}
              <div id="product-image-placeholder" class="w-full h-full flex items-center justify-center text-9xl">🐾</div>
            {% endif %}
          </div>

          {# Product Info #}
          <div class="flex flex-col gap-8">

            {# Title block #}
            <div>
              <p class="font-hobeaux text-sm font-bold text-teal uppercase tracking-widest mb-3">{{ product.type.name }}</p>
              <h1 class="font-anton text-charcoal text-5xl lg:text-6xl leading-tight">{{ product.title }}</h1>
              {% if variants|length > 1 %}
                <p class="font-hobeaux text-lg text-charcoal/60 mt-2" id="selected-variant-label">{{ activeVariant.title }}</p>
              {% endif %}
            </div>

            {# Price — updates via JS on variant change #}
            <div id="selected-price" class="flex items-baseline gap-4">
              {% if activeVariant.onPromotion %}
                <span class="font-anton text-charcoal/40 text-3xl line-through" id="price-original">{{ activeVariant.priceAsCurrency }}</span>
                <span class="font-anton text-charcoal text-5xl" id="price-display">{{ activeVariant.salePriceAsCurrency }}</span>
                <span class="font-hobeaux text-sm font-bold text-teal bg-teal/10 px-3 py-1 rounded-full" id="sale-badge">Sale</span>
              {% else %}
                <span class="font-anton text-charcoal/40 text-3xl line-through hidden" id="price-original"></span>
                <span class="font-anton text-charcoal text-5xl" id="price-display">{{ activeVariant.priceAsCurrency }}</span>
                <span class="font-hobeaux text-sm font-bold text-teal bg-teal/10 px-3 py-1 rounded-full hidden" id="sale-badge">Sale</span>
              {% endif %}
            </div>

            {{ sprig('_sprig/add-to-cart', {productId: product.id}) }}

            {# Nutritional Info — variant supersedes product #}
            {% set nutritionContent = activeVariant.nutrition ?? product.nutrition ?? null %}
            {% if nutritionContent %}
              <div class="border-t border-gray-200 pt-6">
                <h3 class="font-hobeaux font-bold text-base text-charcoal mb-3">Nutritional Info</h3>
                <div class="font-hobeaux text-sm text-charcoal/70 prose prose-sm max-w-none">
                  {{ nutritionContent }}
                </div>
              </div>
            {% endif %}

            <a href="{{ category ? category.url : url('shop') }}" class="inline-flex items-center gap-2 font-hobeaux font-bold text-base text-charcoal/70 hover:text-teal transition-colors">
              &larr; Back to {{ category ? category.title : 'Shop' }}
            </a>

          </div>

        </div>

      {% endif %}

    </div>
  </section>

  <script>
  function stepQty(btn, direction) {
    const input = btn.parentElement.querySelector('input[type="number"]');
    if (input) input.value = Math.max(1, parseInt(input.value || 1) + direction);
  }

  // Event delegation — survives Sprig re-renders
  document.addEventListener('change', function(e) {
    if (!e.target.matches('input[name="purchasables[0][id]"]')) return;

    const label = e.target.closest('label');
    const title = label.dataset.variantTitle;
    const price = label.dataset.price;
    const salePrice = label.dataset.salePrice;
    const onPromotion = label.dataset.onPromotion === 'true';

    const $label = document.getElementById('selected-variant-label');
    const $display = document.getElementById('price-display');
    const $original = document.getElementById('price-original');
    const $saleBadge = document.getElementById('sale-badge');

    if ($label) $label.textContent = title;

    const variantImage = label.dataset.variantImage;
    const $img = document.getElementById('product-image');
    if ($img && variantImage) $img.src = variantImage;

    if (onPromotion) {
      $display.textContent = salePrice;
      $original.textContent = price;
      $original.classList.remove('hidden');
      if ($saleBadge) $saleBadge.classList.remove('hidden');
    } else {
      $display.textContent = price;
      $original.textContent = '';
      $original.classList.add('hidden');
      if ($saleBadge) $saleBadge.classList.add('hidden');
    }
  });

  // Re-sync price/image after Sprig swaps the component
  document.addEventListener('htmx:afterSwap', function(e) {
    const radio = e.target.querySelector('input[name="purchasables[0][id]"]:checked');
    if (radio) radio.dispatchEvent(new Event('change', { bubbles: true }));
  });
  </script>

{% endblock %}
