{% extends '_layout.twig' %}

{% block content %}

    {% include '_components/pageHero.twig' with {
        params: {
            img: "https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=1600&q=80",
            title: "All Treats",
            subTitle: "The Barkery Shop"
        }
    } %}

    <section class="bg-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            {# Filters + Sort #}
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
                <h2 class="text-lg sm:text-xl md:text2-xl lg:text-3xl text-center text-teal font-anton">Shop By Category</h2>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
                {% set products = craft.products.all() %}
                {% for product in products %}
                    <a href="#"
                       class="group flex flex-col">
                        {# Image #}
                        <div class="relative overflow-hidden rounded-2xl bg-gray-100 aspect-square mb-4">
                            {% if product.images|length %}
                                <img
                                    src="{{ product.images.one().url }}"
                                    alt="{{ product.title }}"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                />
                            {% endif %}

                            {# Quick add #}
                            <button
                                type="button"
                                class="absolute bottom-3 right-3 bg-white text-charcoal hover:bg-teal hover:text-white transition-colors rounded-full w-10 h-10 flex items-center justify-center shadow-md"
                                aria-label="Add to cart"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-5 w-5"
                                     fill="none"
                                     viewBox="0 0 24 24"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          d="M12 4v16m8-8H4"/>
                                </svg>
                            </button>
                        </div>
                        {# Details #}
                        <h3 class="font-hobeaux font-bold text-charcoal text-sm leading-snug group-hover:text-teal transition-colors">{{ product.title }}</h3>
                        <div class="flex items-center gap-2 mt-1">
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
