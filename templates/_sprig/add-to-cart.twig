{#
  Sprig component: reactive add-to-cart
  Variables: productId (int, required), variantId (int, optional)
#}

{% set product = craft.products().id(productId).one() %}
{% set variants = product.getVariants() %}

{% set activeVariant = variants[0] %}
{% if variantId is defined and variantId %}
  {% for v in variants %}
    {% if v.id == variantId %}
      {% set activeVariant = v %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set showVariants = variants|length > 1 and (variantId is not defined or not variantId) %}

{# OOB swap: update nav cart badge after successful add #}
{% if sprig.isSuccess %}
  {% set cartQty = craft.commerce.carts.cart.totalQty ?? 0 %}
  <span id="cart-count" hx-swap-oob="true"
    class="absolute -top-2 -right-2 bg-teal text-white text-xs rounded-full h-5 w-5 flex items-center justify-center text-[11px] font-bold {{ cartQty < 1 ? 'hidden' }}">
    {{ cartQty }}
  </span>
{% endif %}

{% if sprig.isSuccess %}
  <div class="bg-teal/10 text-teal font-hobeaux font-bold text-sm px-5 py-4 rounded-2xl flex items-center gap-3 mb-6">
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
    </svg>
    <span>{{ product.title }} added to your cart!</span>
    <a href="{{ url('shop/cart') }}" class="ml-auto underline hover:no-underline">View Cart &rarr;</a>
  </div>
{% endif %}

<form sprig s-action="commerce/cart/update-cart" s-method="post" class="flex flex-col gap-7">

    {% if showVariants %}
      {% include 'shop/products/_includes/variant-selector' %}
    {% else %}
      {{ hiddenInput('purchasables[0][id]', activeVariant.id) }}
    {% endif %}

    {% include 'shop/products/_includes/custom-options' %}

    {# Qty + Add to Cart #}
    <div class="flex items-center gap-4">
      <div class="flex items-center border-2 border-gray-200 rounded-full bg-white">
        <button type="button" onclick="stepQty(this, -1)" aria-label="Decrease quantity"
          class="w-12 h-12 flex items-center justify-center font-bold text-charcoal hover:text-teal transition-colors text-2xl rounded-full leading-none">
          &minus;
        </button>
        <input type="number" name="purchasables[0][qty]" value="1" min="1"
          class="w-12 text-center font-hobeaux text-lg font-bold text-charcoal focus:outline-none bg-transparent">
        <button type="button" onclick="stepQty(this, 1)" aria-label="Increase quantity"
          class="w-12 h-12 flex items-center justify-center font-bold text-charcoal hover:text-teal transition-colors text-2xl rounded-full leading-none">
          +
        </button>
      </div>
      <button type="submit"
        class="flex-1 cursor-pointer font-hobeaux font-bold text-base uppercase tracking-widest bg-teal text-white py-4 rounded-full hover:bg-charcoal transition-colors shadow-md shadow-teal/20">
        Add to Cart
      </button>
    </div>

    {# Trust signals #}
    <div class="flex flex-wrap gap-4 text-sm font-hobeaux text-charcoal/60 border-t border-gray-200 pt-6">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Handmade in Charlotte, NC
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Dog-safe ingredients
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-teal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Ships across the US
      </span>
    </div>

  </form>
