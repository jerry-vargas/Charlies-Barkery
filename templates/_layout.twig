<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <title>Charlies Barkery</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="referrer" content="origin-when-cross-origin" />
    {{ craft.vite.script("src/app.js", false) }}
    {{ head() }}
</head>
<body class="ltr">
{% include "_includes/banner.twig" %}
{% include "_includes/nav.twig" %}
{% set flashes = craft.app.session.getAllFlashes(true) %}
{% if flashes %}
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-2">
        {% for type, message in flashes %}
            <div class="font-hobeaux text-sm px-4 py-3 rounded-xl {{ type == 'error' ? 'bg-red-50 text-red-700' : 'bg-teal/10 text-teal' }}">{{ message }}</div>
        {% endfor %}
    </div>
{% endif %}

{% block content %}
{% endblock %}

{% include "_includes/footer.twig" %}
{% include "_includes/symbols.twig" %}
{{ endBody() }}
</body>
</html>